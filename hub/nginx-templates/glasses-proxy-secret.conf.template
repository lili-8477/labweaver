# Rendered at container start by the nginx image's envsubst step into
# /etc/nginx/conf.d/glasses-proxy-secret.conf, from GLASSES_PROXY_SECRET in
# hub/.env. nginx sends it to the indexer on /api/glasses/ so the indexer can
# tell nginx apart from user containers, which share its docker network.
map $host $glasses_proxy_secret {
    default "${GLASSES_PROXY_SECRET}";
}
